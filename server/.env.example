# ============================================
#  EMAIL (Gmail OAuth2) — mailer/mail.service.ts
# ============================================

# Gmail-адрес, с которого отправляются письма (обязательно совпадает с OAuth-аккаунтом)
GMAIL_ADDRESS=helpcleanprobg@gmail.com

# OAuth 2.0 Client ID (Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID_MAIL=xxxxxxxxxxxx.apps.googleusercontent.com

# OAuth 2.0 Client Secret
GOOGLE_CLIENT_SECRET_MAIL=GOCSPX-xxxxxxxxxxxxxxxx

# Redirect URI, указанный в том же OAuth-клиенте
GOOGLE_REFRESH_REDIRECT_MAIL_URL=https://developers.google.com/oauthplayground

# Refresh-токен (должен быть выдан ЭТИМ ЖЕ клиентом со скоупом https://mail.google.com/)
GOOGLE_REFRESH_TOKEN_MAIL=1//0xxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
#  TELEGRAM — notification/notification.service.ts
# ============================================

# Токен бота от @BotFather
TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
#  MONGODB — app.module.ts
# ============================================

MONGO_LINK=mongodb://user:password@localhost:27017/helpcleanpro
DB_NAME=helpcleanpro

# ============================================
#  SERVER
# ============================================

APP_PORT=5000
